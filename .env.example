# Copy this file to ".env" (same folder as wdio.conf.ts) and fill in real values.
# This file is read automatically by the WDIO CLI on startup - see wdio.conf.ts
# for the exact lines where these variables are consumed.

# Target environment: sit (https://login.salesforce.com) | sitPartial (https://test.salesforce.com)
ORG=sit

# Real Salesforce credentials go here - required for the login spec to pass.
USERNAME=<your-username-here>
PASSWORD=<your-password-here>

# Base32 TOTP secret for the Salesforce MFA / "Verify Your Identity" step.
MFA_SECRET=<your-mfa-secret-here>

# Set to true for headless Chrome, false to watch the browser locally.
HEADLESS=true
